{
  "name": "dsh-kylin-pet",
  "version": "0.1.0",
  "description": "麒麟仔 vs 鲸鱼娘 —— 双宠同台桌宠。clean-room 原创实现：机制参考 PC2005-cloud/dsh-pet（MIT），零上游代码/素材/文案。",
  "type": "module",
  "main": "./src/server/entry.js",
  "exports": {
    ".": "./src/server/entry.js",
    "./client": "./src/stage/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "harness": "node tools/harness.mjs",
    "check": "node --check src/shared/contract.js && node --check src/server/entry.js && node --check src/server/pet-config.js && node --check src/server/static-assets.js && node --check src/stage/client.js"
  },
  "license": "MIT",
  "engines": { "node": ">=22" },
  "files": ["src", "assets", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-connection"], "platform": "web" },
    "compatibility": { "dshReleases": { "0.2.0-rc.1": "compatible", "0.2.0-rc.2": "compatible", "0.2.1-alpha.2": "compatible" } }
  }
}
